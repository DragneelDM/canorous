# Canorous Technologies - Environment Configuration
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# Database Configuration
DB_HOST=localhost
DB_USER=your_database_user
DB_PASS=your_database_password
DB_NAME=your_database_name

# Email Configuration (for PHPMailer)
SMTP_HOST=mail.can-india.co.in
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=sales@can-india.co.in
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=sales@can-india.co.in
SMTP_FROM_NAME="Canorous Technologies"

# Security Configuration
TOKEN_EXPIRY_DAYS=90
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MINUTES=60
RATE_LIMIT_LOCKOUT_MINUTES=30

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2y$10$yourhashedpasswordhere

# Application Settings
APP_ENV=production
APP_DEBUG=false
BASE_URL_OVERRIDE=
